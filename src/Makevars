# Recompilar TUDO quando um header muda: o make do R nao rastreia dependencia de header, e
# mudar o layout de uma struct compartilhada com so parte dos .o recompilados produz um
# executavel que mistura duas versoes da mesma struct — o sintoma foi um std::bad_alloc num
# modelo que passava, e podia ter sido pior: podia ter sido um numero.
$(SHLIB): $(OBJECTS)
$(OBJECTS): estruturas.h modelo.h mme.h
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
